{
  "name": "@js-nerds/version-compare",
  "version": "0.1.0",
  "description": "Tiny utility to compare version strings.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "keywords": [
    "version",
    "compare",
    "semver",
    "string",
    "utility"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/js-nerds/version-compare.git"
  },
  "homepage": "https://github.com/js-nerds/version-compare#readme",
  "bugs": {
    "url": "https://github.com/js-nerds/version-compare/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --dts --format cjs,esm --sourcemap --clean",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@vitest/coverage-v8": "^3.2.4"
  }
}
